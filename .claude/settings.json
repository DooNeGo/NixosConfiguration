{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -df:*)",
      "Bash(git branch -d* -f*)",
      "Bash(git branch -d*--force*)",
      "Bash(git branch --delete*--force*)",
      "Bash(git tag* -f*)",
      "Bash(git tag*--force*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout* .)",
      "Bash(git restore* .)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push* -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-new-file.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-nix.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-stop.sh"
          }
        ]
      }
    ]
  }
}
