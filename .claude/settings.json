{
  "permissions": {
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git push:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d -f:*)",
      "Bash(git branch -d --force:*)",
      "Bash(git branch -f -d:*)",
      "Bash(git branch -df:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout .:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git checkout HEAD -- .:*)",
      "Bash(git restore .:*)",
      "Bash(git restore -- .:*)",
      "Bash(git restore --staged --worktree .:*)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push* -f*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-new-file.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-nix.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-stop.sh"
          }
        ]
      }
    ]
  }
}
