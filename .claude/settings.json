{
  "permissions": {
    "ask": [
      "Bash(git rebase:*)",
      "Bash(git push:*)",
      "Bash(git branch -D:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout .:*)",
      "Bash(git restore .:*)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push* -f*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-new-file.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-stop.sh" }]
      }
    ]
  }
}
