/* Two separate glass panels like the bar islands: the input field and the list. Colours: matugen names from palette/rofi.rasi. */
@import "~/.local/state/wallpaper-palette/rofi.rasi"

configuration {
    font: "@font_family@ 12";
}

/* Without this a widget that sets no background draws rofi's default one. */
* {
    background-color: transparent;
    border-color: transparent;
    text-color: @on_surface;
}

window {
    transparency: "real";
    background-color: transparent;
    border: 0;
    padding: 0;
    width: 640px;
    /* Pinned by the top edge: the window keeps its top when a search shortens the list. */
    location: north;
    anchor: north;
    y-offset: 22%;
}

mainbox {
    background-color: transparent;
    spacing: @gap@px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface_container_high_panel;
    border: @glass_border_width@px;
    border-color: @outline_variant;
    border-radius: @radius@px;
    padding: 12px 18px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @on_surface_variant;
}

entry {
    background-color: transparent;
    text-color: @on_surface;
    placeholder: "Поиск";
    placeholder-color: @on_surface_variant;
}

listview {
    background-color: @surface_container_high_panel;
    border: @glass_border_width@px;
    border-color: @outline_variant;
    border-radius: @radius@px;
    padding: 8px;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
    fixed-height: false;
}

element {
    background-color: transparent;
    border-radius: @radius_inner@px;
    padding: 8px 12px;
    spacing: 12px;
    text-color: @on_surface;
}

element selected.normal {
    background-color: @primary;
    text-color: @on_primary;
}

element-icon {
    size: 1.6em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
