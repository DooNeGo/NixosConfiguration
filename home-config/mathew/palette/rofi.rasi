* {
    glass: #{{colors.@role_glass_fill@.default.hex_stripped}}@glass_alpha_hex@;
    glass-border: #{{colors.@role_glass_border@.default.hex_stripped}}@glass_border_hex@;
    fg: #{{colors.@role_text@.default.hex_stripped | lighten: @text_soften@}};
    fg-dim: #{{colors.@role_text_dim@.default.hex_stripped | lighten: @dim_soften@}};
    accent: #{{colors.@role_accent@.default.hex_stripped | lighten: @accent_soften@}};
    accent-soft: #{{colors.@role_accent@.default.hex_stripped | lighten: @accent_soften@}}33;
}
