* {
    glass: #{{colors.surface_container_high.default.hex_stripped}}@glass_alpha@;
    glass-border: #{{colors.on_surface.default.hex_stripped}}@glass_border@;
    fg: #{{colors.on_surface.default.hex_stripped}};
    fg-dim: #{{colors.on_surface_variant.default.hex_stripped}};
    accent: #{{colors.primary.default.hex_stripped}};
    accent-soft: #{{colors.primary.default.hex_stripped}}33;
}
