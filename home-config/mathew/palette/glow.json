{
  "document": { "margin": 0 },
  "heading": { "bold": true, "color": "4" },
  "h1": { "prefix": "█ ", "color": "4" },
  "h2": { "prefix": "▌ " },
  "h3": { "prefix": "▎ " },
  "strong": { "bold": true },
  "emph": { "italic": true },
  "code": {
    "color": "{{colors.on_surface.default.hex}}",
    "background_color": "{{colors.surface_container_highest.default.hex}}"
  },
  "code_block": { "margin": 1 },
  "link": { "color": "6", "underline": true },
  "link_text": { "color": "6", "bold": true },
  "block_quote": { "color": "8", "indent": 1, "indent_token": "│ " },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "hr": { "color": "8", "format": "────────" }
}
