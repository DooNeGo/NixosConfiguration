{
  inputs = {
    nix-openclaw.url = "github:openclaw/nix-openclaw/v2026.9.5";
    nixpkgs.follows = "nix-openclaw/nixpkgs";
    home-manager.follows = "nix-openclaw/home-manager";
    kokoro.url = "path:../../kokoro";
    nixpkgs-unstable.url = "github:NixOS/nixpkgs/nixos-unstable";
    nixpkgs-stable.url = "github:NixOS/nixpkgs/nixos-26.05";
  };

  outputs =
    inputs@{
      nixpkgs,
      home-manager,
      nix-openclaw,
      kokoro,
      ...
    }:
    let
      system = "x86_64-linux";
      lib = nixpkgs.lib;

      pkgs = import nixpkgs {
        inherit system;
        config = {
          allowUnfree = true;
          android_sdk.accept_license = true;
        };
        overlays = [
          nix-openclaw.overlays.default
          # TEMPORARY: OpenClaw gateway v2026.10.3 on upstream's npm route; remove when nix-openclaw ships >=2026.10.3.
          # nix-openclaw's 2026.9.5 pin builds the gateway from the npm package by default. Setting gatewaySrc
          # would select the pnpm source route instead, so this overlay keeps the npm route and supplies:
          #   npm/openclaw-2026.10.3/  vendored wrapper package.json + package-lock.json (generated, not edited)
          #   npm/patch-openclaw-npm-dist.mjs  dist patch ported to the 2026.10.3 module layout
          #   npm/gateway-npm.nix  copy of nix-openclaw's npm gateway derivation, pointed at the files above
          #   npm/runtime-plugins/  acpx 2026.10.3 lock generated by nix-openclaw's update-openclaw-runtime-plugin-locks.mjs,
          #                         plus a copy of its openclaw-runtime-plugin.nix that reads the lock from this directory
          #(final: prev:
            #let
              #sourceInfo = {
                #releaseTag = "v2026.10.3";
                #releaseVersion = "2026.10.3";
                #runtimePluginVersion = "2026.10.3";
                #rev = "59cb44796b0f1f0daa0e37af8b1495abb45d9bc1";
                #gatewayNpmDepsHash = "sha256-Od2ZgFMP2suhW8Vmp81He1krF9ujgeNomBumgSaUCcY=";
              #};
              #buildRuntimePlugin = final.callPackage ./npm/runtime-plugins/openclaw-runtime-plugin.nix {
                #linkOpenClawPeer = false;
                #nixOpenclaw = nix-openclaw;
              #};
              #bundledAcpx = buildRuntimePlugin (
                #import ./npm/runtime-plugins/acpx.nix
              #);
              #newGateway = final.callPackage ./npm/gateway-npm.nix {
                #inherit sourceInfo bundledAcpx;
                #nixOpenclaw = nix-openclaw;
              #};
              #toolSets = import "${nix-openclaw}/nix/tools/extended.nix" {
                #pkgs = final;
                #openclawToolPkgs = {
                  #pnpm = final.callPackage "${nix-openclaw}/nix/packages/pnpm-12.nix" { };
                #};
              #};
            #in
            #{
              #openclaw-gateway = newGateway;
              #openclaw = final.callPackage "${nix-openclaw}/nix/packages/openclaw-batteries.nix" {
                #openclaw-gateway = newGateway;
                #openclaw-app = null;
                #extendedTools = toolSets.tools;
                #version = sourceInfo.releaseVersion;
              #};
            #}
          #)
          (final: prev: {
            kokoro-ru = kokoro.packages.${system}.kokoro-ru;
            unstable = import inputs.nixpkgs-unstable {
              inherit system;
              config.allowUnfree = true;
            };
            stable = import inputs.nixpkgs-stable {
              inherit system;
              config.allowUnfree = true;
            };
            openclawRuntimePlugins = (prev.openclawRuntimePlugins or { }) // {
              "lossless-claw" = import ./lossless-claw.nix { pkgs = final; };
            };
          })
        ];
      };

      mkUser =
        name:
        home-manager.lib.homeManagerConfiguration {
          inherit pkgs;
          modules = [
            ./home.nix
          ];
          extraSpecialArgs = {
            inherit inputs;
            username = name;
          };
        };
    in
    {
      homeConfigurations = lib.genAttrs [ "openclaw" ] mkUser;
      packages.${system} = {
        kokoro-ru = pkgs.kokoro-ru;
        openclaw-gateway = pkgs.openclaw-gateway;
      };
    };
}
