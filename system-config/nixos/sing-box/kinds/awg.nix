# kind = "awg": credentialFile holds the server-issued AmneziaWG .conf or an
# Amnezia vpn:// string, verbatim. The -awg-prepare oneshot normalises it,
# wg-quick brings up awg.interface with routes in awg.table, and sing-box binds
# its "proxy" outbound to that interface.
{
  pkgs,
  name,
  inst,
  secretFile,
  shared,
  ...
}:

let
  inherit (inst.awg) interface table;
  ip = "${pkgs.iproute2}/bin/ip";

  prepareAwg = pkgs.writeShellApplication {
    name = "sing-box-awg-prepare";
    text = builtins.readFile ./awg-prepare.sh;
    runtimeInputs = with pkgs; [
      coreutils
      gnugrep
      gnused
      gawk
      python3
    ];
  };

  # Must stay below Tailscale's policy rules (5210-5270).
  rulePriority = "5000";

  prepare = "sing-box-${name}-awg-prepare";
  wgUnit = "wg-quick-${interface}";

  # Runtime files of the interface, written by the -awg-prepare oneshot.
  runDir = "/run/sing-box-awg-${interface}";
  confFile = "${runDir}/${interface}.conf"; # 0600 root
  addrFile = "${runDir}/address"; # 0644, tunnel IPv4

  tableStr = toString table;
in
{
  services = {
    ${prepare} = {
      description = "Normalise the AmneziaWG config of sing-box instance '${name}' for ${interface}";
      requiredBy = [ "${wgUnit}.service" ];
      before = [ "${wgUnit}.service" ];
      restartTriggers = [ secretFile ];
      environment = {
        SING_BOX_AWG_SOURCE_FILE = inst.credentialFile;
        SING_BOX_AWG_OUT_FILE = confFile;
        SING_BOX_AWG_ADDR_FILE = addrFile;
        SING_BOX_AWG_TABLE = tableStr;
        SING_BOX_DECODE_VPN = "${shared.decodeVpn}";
      };
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = "yes";
        # parses an untrusted string as root, needs no network and writes only its RuntimeDirectory
        NoNewPrivileges = true;
        PrivateTmp = true;
        PrivateNetwork = true;
        ProtectSystem = "strict";
        ProtectHome = true;
        RuntimeDirectory = "sing-box-awg-${interface}";
        RuntimeDirectoryMode = "0755";
        RuntimeDirectoryPreserve = "yes";
        ExecStart = "${prepareAwg}/bin/sing-box-awg-prepare";
      };
    };

    # Extends the unit generated by networking.wg-quick: ordering plus the
    # policy rule that sends packets sourced from the tunnel address to awg.table.
    ${wgUnit} = {
      requires = [ "${prepare}.service" ];
      after = [ "${prepare}.service" ];
      restartTriggers = [ secretFile ];
      postStart = ''
        addr=$(cat ${addrFile})
        ${ip} -4 rule del from "$addr" lookup ${tableStr} priority ${rulePriority} 2>/dev/null || true
        ${ip} -4 rule add from "$addr" lookup ${tableStr} priority ${rulePriority}
      '';
      postStop = ''
        if [ -r ${addrFile} ]; then
          ${ip} -4 rule del from "$(cat ${addrFile})" lookup ${tableStr} priority ${rulePriority} 2>/dev/null || true
        fi
      '';
    };
  };

  # type = "amneziawg" pulls in the kernel module and amneziawg-tools.
  extraConfig.networking.wg-quick.interfaces.${interface} = {
    type = "amneziawg";
    configFile = confFile;
  };

  deps = [
    "${prepare}.service"
    "${wgUnit}.service"
  ];

  # the generator bakes the tunnel address into config.json
  restartTriggers = [ secretFile ];

  environment = {
    SING_BOX_AWG_INTERFACE = interface;
    SING_BOX_AWG_ADDR_FILE = addrFile;
  };

  failureUnits = [
    wgUnit
    prepare
  ];

  exitTunnel = { inherit interface table; };

  claims = {
    interface = [ interface ];
    table = [ table ];
  };
}
